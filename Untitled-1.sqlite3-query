INSERT INTO Recipes (RecipeID, Title, Creator, Ingredients, Category, Website, RecipeLink) VALUES(1,'Chicken and Leek Pie', 'Nagi Maehashi', '3 1/2 tbsp unsalted butter ,750g/ 1.5lb chicken thighs skinless boneless, 1/4 tsp each black pepper and cooking salt (kosher salt),80g / 3 oz streaky bacon , chopped into 1cm / 0.4″ squares, 2 leeks, 2 celery stems, 2 garlic cloves finely minced, 1/3 cup chardonnay or other dry white wine, 1/4 cup flour (plain / all-purpose), 1 tbsp dijon mustard, 2 thyme sprigs (or 1/2 tsp dried thyme), 2 bay leaves, 1 cup chicken stock, 1 cup thickened / heavy cream, 1/2 tsp cooking salt, 1/4 tsp black pepper, 2 x 20cm / 8" frozen butter puff pastry sheets, 1 egg ', 'Dinner', 'Recipetineats', 'https://www.recipetineats.com/chicken-and-leek-pie/');
INSERT INTO Recipes (RecipeID, Title, Creator, Ingredients, Category, Website, RecipeLink) VALUES(2,'BBQ Butterflied Lamb', 'Vanya Insull', '2 Tbsp olive oil, 3 clove garlic, crushed, 1 tbsp ground cumin, 2 tbsp fresh rosemary chopped,1 tsp salt, ½ tsp black pepper, 1.5 kg butterflied lamb leg or shoulder, ¼ cup mint, ¼ cup parsley, 1 garlic clove, 2 tsp brown sugar, 1 tbsp apple cider vinegar, 3 tbsp olive oil, ½ tsp salt, 2 Tbsp water', 'Dinner', 'vjcooks.com', 'https://vjcooks.com/bbq-lamb-with-mint-sauce/#mv-creation-838-jtr');
INSERT INTO Recipes (RecipeID, Title, Creator, Ingredients, Category, Website, RecipeLink) VALUES(3,'Sticky Five Spice Beef', 'Vanya Insull', '1 kg beef blade steak (sliced into 2 cm thick strips), 1 Tbsp flour, 1 beef stock cube, 2 cups boiling water, ¼ cup low salt soy sauce, 2 Tbsp sweet chilli sauce, 2 Tbsp apple cider vinegar, 2 Tbsp brown sugar, 2 tsp Chinese 5 spice powder, 1 tsp ground coriander, 1 tsp sesame oil, 1 tsp garlic powder, Shake of chilli flakes, 3 star anise, optional, 1 tsp sesame seeds, 1 spring onion, sliced, Cooked white rice, Steamed bok choy, green beans and broccolini', 'Dinner', 'vjcooks.com', 'https://vjcooks.com/sticky-five-spice-beef/');
INSERT INTO Recipes (RecipeID, Title, Creator, Ingredients, Category, Website, RecipeLink) VALUES(4, 'Roti Chicken Curry', 'Grace Bowen', '2 Tbsp oil, 1 onion, finely diced, 1 Tbsp fresh ginger, grated, 3 clove garlic, crushed, 2 carrot, 200g potato, ½ red capsicum, 150g purple kumara, 500g boneless chicken thighs, cut into chunks, 4 tsp mild curry powder, 250ml coconut cream, 300 ml boiling water, 1 chicken stock cube, ¼ tsp chilli flakes, ½ cup frozen peas, , 1 clove garlic, crushed, 1 tbsp oil, 240g premade roti', 'Dinner', 'vjcooks.com', 'https://vjcooks.com/chicken-curry-roti-pie/#ingredient-notes');
