-- database: ./database.db


-- 1. Turn off foreign keys temporarily and clear out the leftover table causing the error
PRAGMA foreign_keys = OFF;
DROP TABLE IF EXISTS Recipes_new;
DROP TABLE IF EXISTS RecipeIngredients_new;

-- 2. Create the new Recipes table with the correct constraints
CREATE TABLE Recipes_new (
    RecipeID NUMERIC NOT NULL PRIMARY KEY,
    Title TEXT UNIQUE,
    Creator TEXT,
    Image TEXT,
    Ingredients TEXT
);

-- 3. Safely copy all your existing data into the new table structure
INSERT INTO Recipes_new (RecipeID, Title, Creator, Image, Ingredients)
SELECT RecipeID, Title, Creator, Image, Ingredients 
FROM Recipes;

-- 4. Swap the old table with your newly configured table
DROP TABLE Recipes;
ALTER TABLE Recipes_new RENAME TO Recipes;

-- 5. Turn foreign key enforcement back on
PRAGMA foreign_keys = ON;
